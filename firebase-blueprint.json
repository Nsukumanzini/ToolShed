{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing role, business details, contact information, and verification status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["seller", "customer", "both"] },
        "businessName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "idNumberMasked": { "type": "string", "maxLength": 50 },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "email", "name", "role", "city", "province"]
    },
    "ToolItem": {
      "title": "ToolItem",
      "description": "Tool or heavy equipment listing available for hire in the marketplace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "brand": { "type": "string", "maxLength": 80 },
        "model": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "dailyRate": { "type": "number" },
        "weeklyRate": { "type": "number" },
        "deposit": { "type": "number" },
        "replacementValue": { "type": "number" },
        "powerSource": { "type": "string", "maxLength": 50 },
        "condition": { "type": "string", "maxLength": 50 },
        "isAvailable": { "type": "boolean" },
        "deliveryAvailable": { "type": "boolean" },
        "deliveryFee": { "type": "number" },
        "instantBooking": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 120 },
        "ownerAvatar": { "type": "string", "maxLength": 1000 },
        "ownerType": { "type": "string", "maxLength": 50 },
        "locationCity": { "type": "string", "maxLength": 100 },
        "locationNeighborhood": { "type": "string", "maxLength": 100 },
        "locationDistanceKm": { "type": "number" },
        "images": { "type": "array" },
        "tags": { "type": "array" },
        "includedAccessories": { "type": "array" },
        "safetyRequirements": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "title", "brand", "category", "dailyRate", "ownerId", "locationCity"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Equipment hire booking or reservation record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "toolId": { "type": "string", "maxLength": 128 },
        "toolTitle": { "type": "string", "maxLength": 150 },
        "toolImage": { "type": "string", "maxLength": 1000 },
        "renterId": { "type": "string", "maxLength": 128 },
        "renterName": { "type": "string", "maxLength": 120 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "days": { "type": "number" },
        "dailyRate": { "type": "number" },
        "totalRental": { "type": "number" },
        "refundableDeposit": { "type": "number" },
        "deliveryType": { "type": "string", "maxLength": 50 },
        "totalPaid": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "active", "upcoming", "completed", "cancelled"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentReference": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "toolId", "renterId", "ownerId", "startDate", "endDate", "totalPaid", "status"]
    },
    "MessageThread": {
      "title": "MessageThread",
      "description": "Chat thread between a tool owner and borrower.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "toolId": { "type": "string", "maxLength": 128 },
        "toolTitle": { "type": "string", "maxLength": 150 },
        "toolImage": { "type": "string", "maxLength": 1000 },
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "lastMessageTime": { "type": "string", "maxLength": 60 },
        "unread": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "toolId", "participantIds"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents indexed by user ID."
    },
    "/tools/{toolId}": {
      "schema": "ToolItem",
      "description": "Public tool and equipment listings."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Rental bookings between borrowers and equipment owners."
    },
    "/threads/{threadId}": {
      "schema": "MessageThread",
      "description": "Messaging threads between participants."
    }
  }
}
